{
  "typography": {
    "bodyFont": {
      "$type": "fontFamily",
      "$value": "Inter"
    },
    "displayFont": {
      "$type": "fontFamily",
      "$value": "Inter"
    }
  },
  "color": {
    "action": {
      "primary": {
        "$type": "color",
        "$value": "{color.palette.primary}"
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.palette.secondary}"
      }
    },
    "border": {
      "focus": {
        "$type": "color",
        "$value": "{color.palette.primary}"
      }
    }
  }
}
