{
  "schemaVersion": 1,
  "defaultTheme": "merce",
  "core": [
    "tokens/core/color.json",
    "tokens/core/spacing.json",
    "tokens/core/radius.json",
    "tokens/core/typography.json"
  ],
  "themes": {
    "merce": {
      "displayName": "Merce",
      "source": [
        "tokens/themes/merce/theme.json"
      ],
      "basePath": "merce.default.json",
      "defaultVariant": "light",
      "variants": {
        "light": "merce.light.json",
        "dark": "merce.dark.json"
      },
      "variantSources": {
        "light": [
          "tokens/themes/merce/variants/light.json"
        ],
        "dark": [
          "tokens/themes/merce/variants/dark.json"
        ]
      }
    },
    "apple": {
      "displayName": "Apple Reference",
      "source": [
        "tokens/themes/apple/theme.json"
      ],
      "path": "apple.json"
    },
    "claude": {
      "displayName": "Claude Reference",
      "source": [
        "tokens/themes/claude/theme.json"
      ],
      "path": "claude.json"
    },
    "airbnb": {
      "displayName": "Airbnb Reference",
      "source": [
        "tokens/themes/airbnb/theme.json"
      ],
      "path": "airbnb.json"
    },
    "stripe": {
      "displayName": "Stripe Reference",
      "source": [
        "tokens/themes/stripe/theme.json"
      ],
      "path": "stripe.json"
    },
    "linear": {
      "displayName": "Linear Reference",
      "source": [
        "tokens/themes/linear/theme.json"
      ],
      "fontAssets": [
        {
          "family": "IoskeleyMono Nerd Font",
          "source": "tokens/themes/linear/fonts/IoskeleyMonoNerdFont-Regular.ttf",
          "destination": "fonts/linear/IoskeleyMonoNerdFont-Regular.ttf",
          "weight": 400,
          "style": "normal",
          "required": true
        },
        {
          "family": "IoskeleyMono Nerd Font",
          "source": "tokens/themes/linear/fonts/IoskeleyMonoNerdFont-Medium.ttf",
          "destination": "fonts/linear/IoskeleyMonoNerdFont-Medium.ttf",
          "weight": 510,
          "style": "normal",
          "required": true
        },
        {
          "family": "IoskeleyMono Nerd Font",
          "source": "tokens/themes/linear/fonts/IoskeleyMonoNerdFont-Bold.ttf",
          "destination": "fonts/linear/IoskeleyMonoNerdFont-Bold.ttf",
          "weight": 700,
          "style": "normal",
          "required": true
        }
      ],
      "defaultVariant": "dark",
      "variants": {
        "dark": "linear.dark.json",
        "light": "linear.light.json"
      },
      "variantSources": {
        "dark": [
          "tokens/themes/linear/variants/dark.json"
        ],
        "light": [
          "tokens/themes/linear/variants/light.json"
        ]
      }
    }
  }
}
